# Public Supabase browser values. These are safe to expose to the browser, but
# the project’s RLS policies and the session-bound RPC enforce client isolation.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy projects can use this instead of the publishable key above:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Auth redirect URLs must include:
# - http://localhost:3000/auth/callback
# - your production origin followed by /auth/callback
# No service-role key is used by this application.
